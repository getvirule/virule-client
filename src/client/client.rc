// virule-client.exe resources: the VIRULE application icon + VERSIONINFO.
// The client is plumbing, but it now owns the native lifecycle surface
// ("Updating…", "Finishing up…", "VIRULE is ready"), so its windows and
// taskbar entries must present as VIRULE (result_card loads icon id 1).
#include <winres.h>
#include "../shared/version.h"

1 ICON "..\\..\\assets\\ViruleAppIcon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 PRODUCTVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VIRULE"
            VALUE "FileDescription", "VIRULE Client"
            VALUE "FileVersion", VIRULE_CLIENT_VERSION_STRING
            VALUE "InternalName", "virule-client"
            VALUE "OriginalFilename", "virule-client.exe"
            VALUE "ProductName", "VIRULE"
            VALUE "ProductVersion", VIRULE_CLIENT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
