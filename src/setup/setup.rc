// Virule-Setup.exe resources: the VIRULE application icon + VERSIONINFO.
// Setup embeds NO client payload: it downloads the approved client release
// from the getvirule/virule-client GitHub Release and verifies it (manifest
// SHA-256 + Authenticode + the VIRULE signing identity) before installing.
#include <winres.h>
#include "../shared/version.h"

// The official VIRULE application icon (the yellow rounded square, dark V;
// the exact asset virule.exe ships), so a downloaded installer presents as
// VIRULE in Explorer/downloads instead of a generic executable. Icon id 1
// mirrors the product's own resource convention.
1 ICON "..\\..\\assets\\ViruleAppIcon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 PRODUCTVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VIRULE"
            VALUE "FileDescription", "VIRULE Setup"
            VALUE "FileVersion", VIRULE_CLIENT_VERSION_STRING
            VALUE "InternalName", "virule-setup"
            VALUE "OriginalFilename", "Virule-Setup.exe"
            VALUE "ProductName", "VIRULE"
            VALUE "ProductVersion", VIRULE_CLIENT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
