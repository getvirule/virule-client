// Virule-Setup.exe resources: VERSIONINFO + the embedded SIGNED client
// payload. helpers/build.ps1 stages the signed virule-client.exe into
// payload\ (and generates payload\payload_hash.h) before this compiles.
#include <winres.h>
#include "../shared/version.h"

// The signed client payload (RCDATA id 1001; setup main.cpp's
// kPayloadResourceId).
1001 RCDATA "payload\\virule-client.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 PRODUCTVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VIRULE"
            VALUE "FileDescription", "VIRULE Setup"
            VALUE "FileVersion", VIRULE_CLIENT_VERSION_STRING
            VALUE "InternalName", "virule-setup"
            VALUE "OriginalFilename", "Virule-Setup.exe"
            VALUE "ProductName", "VIRULE"
            VALUE "ProductVersion", VIRULE_CLIENT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
