// Virule-Setup.exe resources: VERSIONINFO only. Setup embeds NO client
// payload: it downloads the approved client release from
// downloads.virule.app and verifies it (manifest SHA-256 + Authenticode +
// the VIRULE signing identity) before installing.
#include <winres.h>
#include "../shared/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 PRODUCTVERSION VIRULE_CLIENT_VERSION_MAJOR,VIRULE_CLIENT_VERSION_MINOR,VIRULE_CLIENT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VIRULE"
            VALUE "FileDescription", "VIRULE Setup"
            VALUE "FileVersion", VIRULE_CLIENT_VERSION_STRING
            VALUE "InternalName", "virule-setup"
            VALUE "OriginalFilename", "Virule-Setup.exe"
            VALUE "ProductName", "VIRULE"
            VALUE "ProductVersion", VIRULE_CLIENT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
